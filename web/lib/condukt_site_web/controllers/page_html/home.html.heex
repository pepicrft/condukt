<Layouts.app flash={@flash}>
  <section data-part="home">
    <header data-part="hero">
      <div data-part="hero-content">
        <noora-badge appearance="light-fill" color="primary" size="large" dot>
          Elixir library · Terminal CLI · Browser agent · MIT licensed
        </noora-badge>

        <h1>One agent.<br /><span>Every surface.</span></h1>
        <p>
          Condukt is a cross-platform agent framework and coding agent. Its conversation and agent
          loop run on every surface, while each application supplies inference and only the tools
          that make sense there.
        </p>

        <div data-part="hero-actions">
          <noora-button variant="primary" size="large" href="#terminal">
            Try Condukt in your browser
          </noora-button>
          <noora-button
            variant="secondary"
            size="large"
            href="https://github.com/tuist/condukt"
            target="_blank"
            rel="noreferrer"
          >
            View on GitHub
          </noora-button>
        </div>
      </div>

      <div data-part="hero-visual" aria-hidden="true">
        <span data-part="hero-mark">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </div>
    </header>

    <condukt-browser-agent
      id="terminal"
      connected={@connected}
      provider="OpenRouter"
      model={@inference_model}
      inference-endpoint="/api/completions"
      connect-url={~p"/auth/openrouter?#{%{return_to: "/#terminal"}}"}
      disconnect-url={~p"/auth/openrouter"}
      csrf-token={get_csrf_token()}
    >
    </condukt-browser-agent>

    <section id="surfaces" data-part="surfaces">
      <div data-part="surfaces-grid">
        <article data-part="surface">
          <noora-icon name="devices_code" label="Library"></noora-icon>
          <h2>Elixir library</h2>
          <p>
            <code>use Condukt</code> brings agents, tools, sub-agents, MCP, sandboxes, network
            policy, redaction, compaction, and HTTP routes inside any OTP application.
            Sessions are supervised <code>GenServer</code>s that survive crashes, restart from
            snapshots, and stream every model and tool event to a Phoenix LiveView.
          </p>
          <a href={~p"/docs"}>Read the library docs</a>
        </article>

        <article data-part="surface">
          <noora-icon name="terminal" label="Terminal"></noora-icon>
          <h2>Terminal CLI</h2>
          <p>
            A single Rust binary that puts a coding agent in your shell. The TUI keeps
            the conversation visible, the slash menu exposes the same workflows as the
            command line, and <code>condukt exec</code> drives one task from a script
            or build job.
          </p>
          <a href="#install">Install the CLI</a>
        </article>

        <article data-part="surface">
          <noora-icon name="globe" label="Browser"></noora-icon>
          <h2>Browser package</h2>
          <p>
            The portable session runs in <a href="https://webassembly.org">WebAssembly</a>
            and ships as <code>@tuist/condukt</code>. The page supplies inference and
            the complete tool registry, so a public page only inherits the capabilities
            the application explicitly exposes.
          </p>
          <a href={~p"/docs/guide/browser"}>Browser quickstart</a>
        </article>
      </div>
    </section>

    <section id="install" data-part="install">
      <div data-part="install-copy">
        <p data-part="eyebrow">Install</p>
        <h2>Take Condukt to the terminal.</h2>
        <p>
          Install the coding agent globally with mise, then run <code>condukt</code>
          from any project.
        </p>
      </div>
      <condukt-install-command command="mise use -g github:tuist/condukt"></condukt-install-command>
    </section>
  </section>
</Layouts.app>
