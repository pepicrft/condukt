<Layouts.app flash={@flash}>
  <section data-part="blog">
    <header data-part="blog-header">
      <p data-part="eyebrow">Blog</p>
      <h1>That post is not here.</h1>
      <p>The post you tried to open was moved, renamed, or never existed.</p>
    </header>

    <p>
      <a href={~p"/blog"}>Back to all posts</a>
    </p>
  </section>
</Layouts.app>
